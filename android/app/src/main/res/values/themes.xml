<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StockList" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>

    <!-- Shown by the system while the app starts and the saved session is read. -->
    <style name="Theme.StockList.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.StockList</item>
    </style>
</resources>
