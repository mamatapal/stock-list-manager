# Copy to .env on the server (chmod 600 .env). Never commit .env.

# Public name of the API server; its DNS A record must point at this server. The app's api.baseUrl is
# https://<API_DOMAIN>/
API_DOMAIN=api.yourshop.in

# Database passwords: long random values, e.g.  openssl rand -base64 24
DB_PASSWORD=
DB_ROOT_PASSWORD=

# Token signing key: at least 32 random bytes, Base64.  openssl rand -base64 48
# Changing it signs everyone out.
JWT_SIGNING_KEY=
JWT_KEY_ID=k1

# Supplier Management app: its own token signing key (openssl rand -base64 48). Changing it signs suppliers out.
SUPPLIER_JWT_SIGNING_KEY=
# Supplier Administration portal: encrypts the administrators' authenticator keys (openssl rand -base64 32).
# Keep it with your backups: without it, administrators must be reset with create-admin.sh.
ADMIN_TOTP_KEY=

# Time zone used for "today" in expiry lists and reports.
APP_BUSINESS_ZONE=Asia/Kolkata

# Owner password-reset emails (optional but recommended). Without SMTP, owners cannot reset a forgotten password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=Stock List Manager <no-reply@yourshop.in>
# Sender of supplier emails (Supplier Management). Empty: MAIL_FROM is used.
SUPPLIER_MAIL_FROM=

# How email is sent: smtp (default, the SMTP_* settings above) or gmail-api (Gmail API with OAuth 2.0, for a Gmail
# account without an own domain). Full steps: docs/EMAIL_SETUP.md. With gmail-api, MAIL_FROM and SUPPLIER_MAIL_FROM
# must use GMAIL_SENDER or an address in GMAIL_SEND_AS_ALIASES (aliases set up under Gmail > Settings > Accounts >
# "Send mail as"), or the backend does not start.
MAIL_PROVIDER=smtp
GMAIL_SENDER=
GMAIL_SEND_AS_ALIASES=
# The next three are written by tools/windows/gmail-authorize.ps1 over SSH; do not type them here.
# The client secret of a Desktop OAuth client is not confidential; the refresh token is the real secret.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# Backups (deploy/backup.sh)
BACKUP_DIR=/var/backups/stocklist
BACKUP_KEEP_DAYS=30
APP_VERSION=1.0.0
